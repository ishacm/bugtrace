# Copy to .env and fill in locally. Never commit .env.
BUGTRACE_ENV=development
BUGTRACE_LOG_LEVEL=INFO
BUGTRACE_DATA_DIR=var
BUGTRACE_HOST=127.0.0.1
BUGTRACE_PORT=8000

# Model configuration (not used until later tasks)
BUGTRACE_MODEL_NAME=replace-with-model-name
GEMINI_API_KEY=replace-with-your-key
