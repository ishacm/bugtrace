# Copy to .env and fill in locally. Never commit .env.
BUGTRACE_ENV=development
BUGTRACE_LOG_LEVEL=INFO
# text (local) | json (one Cloud Logging line per record; the container default)
BUGTRACE_LOG_FORMAT=text
BUGTRACE_DATA_DIR=var
BUGTRACE_HOST=127.0.0.1
BUGTRACE_PORT=8000

# SWE-bench seeding
BUGTRACE_SWEBENCH_DATASET=princeton-nlp/SWE-bench_Verified
BUGTRACE_SWEBENCH_SPLIT=test
BUGTRACE_SEED_LIMIT=10
BUGTRACE_CASES_PATH=data/cases.jsonl

# Repository workspaces
BUGTRACE_WORKSPACES_DIR=var/workspaces
BUGTRACE_GIT_TIMEOUT_SECONDS=600

# Model configuration. Backend: gemini (Gemini API key, local) | vertex (Vertex AI, ADC)
BUGTRACE_MODEL_BACKEND=gemini
BUGTRACE_MODEL_NAME=replace-with-gemini-model-name
BUGTRACE_MODEL_TIMEOUT_SECONDS=120
GEMINI_API_KEY=replace-with-your-key
# Vertex only (credentials come from `gcloud auth application-default login` locally,
# or the Cloud Run service account; never put a key file here):
# GOOGLE_CLOUD_PROJECT=replace-with-project-id
# GOOGLE_CLOUD_LOCATION=replace-with-vertex-location

# Agent limits
BUGTRACE_AGENT_MAX_ITERATIONS=4
BUGTRACE_AGENT_MAX_TOOL_CALLS=30
BUGTRACE_INVESTIGATIONS_DIR=var/investigations
BUGTRACE_DATABASE_PATH=var/bugtrace.db
BUGTRACE_CHECKPOINT_PATH=var/checkpoints.db
BUGTRACE_AGENT_MAX_PATCH_ATTEMPTS=2

# SWE-bench evaluation (needs Docker). false = never start the harness (Cloud Run).
BUGTRACE_EVALUATION_ENABLED=true

# UI live stream: how often the SSE endpoint re-reads persisted state
BUGTRACE_STREAM_POLL_SECONDS=0.5

# Deployment platform: local (default) | vercel (auto-detected from VERCEL=1).
# vercel forces stepwise execution, Postgres storage and evaluation off (docs/DEPLOYMENT.md).
# BUGTRACE_PLATFORM=local
# background (default: one asyncio task per run) | stepwise (bounded POST .../advance steps)
# BUGTRACE_EXECUTION_MODE=background
# sqlite (default) | postgres (needs DATABASE_URL; required on Vercel, never falls back)
# BUGTRACE_STORAGE_BACKEND=sqlite
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Hybrid Vercel UI + Cloud Run backend.
# Set BUGTRACE_API_BASE_URL only on the Vercel frontend deployment.
# Set BUGTRACE_FRONTEND_ORIGIN only on the Cloud Run backend.
# BUGTRACE_API_BASE_URL=https://bugtrace-backend-xxxxx.run.app
# BUGTRACE_FRONTEND_ORIGIN=https://bugtrace-tau.vercel.app
